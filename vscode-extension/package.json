{
  "name": "contrastapi",
  "displayName": "ContrastAPI: Security Intelligence",
  "description": "Security intelligence tools in your editor, read from the ContrastAPI server: vulnerabilities, domains, IP addresses, packages and a watchlist. The tools work without an API key. The watchlist needs a Pro key.",
  "version": "1.0.0",
  "private": true,
  "publisher": "ContrastAPI",
  "repository": {
    "type": "git",
    "url": "https://github.com/UPinar/contrastapi-clients.git",
    "directory": "vscode-extension"
  },
  "author": "UPinar",
  "homepage": "https://contrastcyber.com",
  "bugs": {
    "url": "https://github.com/UPinar/contrastapi-clients/issues"
  },
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "AI",
    "Linters",
    "Testing"
  ],
  "keywords": [
    "security",
    "cve",
    "kev",
    "cwe",
    "vulnerability",
    "exploit",
    "epss",
    "cisa",
    "osint",
    "threat-intelligence",
    "domain",
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "dependency-scanner",
    "claude",
    "cursor",
    "copilot"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "icon": "resources/icons/logo.png",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "contrastapi",
          "title": "ContrastAPI",
          "icon": "resources/icons/logo.svg"
        }
      ]
    },
    "views": {
      "contrastapi": [
        {
          "id": "contrastapi-sidebar",
          "name": "Security Tools",
          "icon": "resources/icons/logo.svg",
          "contextualTitle": "ContrastAPI"
        },
        {
          "id": "contrastapi-watchlist",
          "name": "Watchlist",
          "icon": "resources/icons/logo.svg",
          "contextualTitle": "ContrastAPI"
        }
      ]
    },
    "commands": [
      {
        "command": "contrastapi.runTool",
        "title": "Run Tool…",
        "category": "ContrastAPI"
      },
      {
        "command": "contrastapi.refreshTools",
        "title": "Refresh Tool List",
        "category": "ContrastAPI",
        "icon": "$(refresh)"
      },
      {
        "command": "contrastapi.cveLookup",
        "title": "CVE Lookup",
        "category": "ContrastAPI"
      },
      {
        "command": "contrastapi.ipLookup",
        "title": "IP Lookup",
        "category": "ContrastAPI"
      },
      {
        "command": "contrastapi.dnsLookup",
        "title": "DNS Lookup",
        "category": "ContrastAPI"
      },
      {
        "command": "contrastapi.sslCheck",
        "title": "SSL Check",
        "category": "ContrastAPI"
      },
      {
        "command": "contrastapi.packageCheck",
        "title": "Package Check",
        "category": "ContrastAPI"
      },
      {
        "command": "contrastapi.runToolFromTree",
        "title": "Run Tool From Sidebar",
        "category": "ContrastAPI"
      },
      {
        "command": "contrastapi.setApiKey",
        "title": "Set API Key",
        "category": "ContrastAPI"
      },
      {
        "command": "contrastapi.clearApiKey",
        "title": "Clear API Key",
        "category": "ContrastAPI"
      },
      {
        "command": "contrastapi.watchlistAdd",
        "title": "Add Watch Item…",
        "category": "ContrastAPI",
        "icon": "$(add)"
      },
      {
        "command": "contrastapi.watchlistRefresh",
        "title": "Refresh Watchlist (re-reads the items, keeps the shown events and the read position)",
        "category": "ContrastAPI",
        "icon": "$(refresh)"
      },
      {
        "command": "contrastapi.watchlistFetchNewEvents",
        "title": "Fetch New Events (moves the read position shared by every client of this API key)",
        "category": "ContrastAPI",
        "icon": "$(cloud-download)"
      },
      {
        "command": "contrastapi.watchlistClear",
        "title": "Clear Watchlist…",
        "category": "ContrastAPI",
        "icon": "$(clear-all)"
      },
      {
        "command": "contrastapi.watchlistRemove",
        "title": "Remove Watch Item",
        "category": "ContrastAPI",
        "icon": "$(trash)"
      },
      {
        "command": "contrastapi.watchlistOpenEvent",
        "title": "Open Watch Event",
        "category": "ContrastAPI"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "contrastapi.runToolFromTree",
          "when": "false"
        },
        {
          "command": "contrastapi.watchlistRemove",
          "when": "false"
        },
        {
          "command": "contrastapi.watchlistOpenEvent",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "contrastapi.refreshTools",
          "when": "view == contrastapi-sidebar",
          "group": "navigation"
        },
        {
          "command": "contrastapi.watchlistAdd",
          "when": "view == contrastapi-watchlist",
          "group": "navigation@1"
        },
        {
          "command": "contrastapi.watchlistRefresh",
          "when": "view == contrastapi-watchlist",
          "group": "navigation@2"
        },
        {
          "command": "contrastapi.watchlistFetchNewEvents",
          "when": "view == contrastapi-watchlist",
          "group": "navigation@3"
        },
        {
          "command": "contrastapi.watchlistClear",
          "when": "view == contrastapi-watchlist",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "contrastapi.watchlistRemove",
          "when": "view == contrastapi-watchlist && viewItem == watchItem",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "ContrastAPI",
      "properties": {
        "contrastapi.baseUrl": {
          "type": "string",
          "default": "https://api.contrastcyber.com",
          "scope": "application",
          "description": "Base URL of the ContrastAPI server. It must use https (http only for localhost). The API key is sent only to api.contrastcyber.com or localhost."
        },
        "contrastapi.mcp.register": {
          "type": "string",
          "scope": "application",
          "enum": [
            "off",
            "on"
          ],
          "enumDescriptions": [
            "Do not offer ContrastAPI to VS Code chat.",
            "Offer ContrastAPI to VS Code chat as an MCP server."
          ],
          "default": "off",
          "description": "Registers ContrastAPI as an MCP server for VS Code chat. An agent in chat then uses your API key and credits. VS Code runs tools marked read-only without asking."
        }
      }
    },
    "viewsWelcome": [
      {
        "view": "contrastapi-sidebar",
        "contents": "No tools loaded yet.\n[Refresh Tool List](command:contrastapi.refreshTools)"
      }
    ],
    "mcpServerDefinitionProviders": [
      {
        "id": "contrastapi",
        "label": "ContrastAPI"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "test": "for f in test/suite/*.test.ts; do tsx \"$f\" || exit 1; done",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/vscode": "^1.101.0",
    "@vscode/vsce": "4.1.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "@vscode/vsce": {
      "minimatch": "^11.0.1"
    }
  }
}
